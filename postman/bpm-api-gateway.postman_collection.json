                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 202', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.employeeId) {",
                  "    pm.environment.set('last_employee_id', jsonData.employeeId);",
                  "}",
                  "if (jsonData.onboardingProcessId) {",
                  "    pm.environment.set('last_onboarding_id', jsonData.onboardingProcessId);",
