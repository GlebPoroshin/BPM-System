                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "var created = jsonData.data && jsonData.data.createEmployee;",
                  "if (created && created.employeeId) {",
                  "    pm.environment.set('last_employee_id', created.employeeId);",
                  "}",
                  "if (created && created.onboardingProcessId) {",
                  "    pm.environment.set('last_onboarding_id', created.onboardingProcessId);",
                  "}"
                ]
              }
            }
