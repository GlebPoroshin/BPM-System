              "raw": "{\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Ivanov\",\n  \"passportSeries\": \"4514\",\n  \"passportNumber\": \"789012\",\n  \"email\": \"alex.ivanov@company.com\",\n  \"phone\": \"+79995554455\",\n  \"contactEmail\": \"alex.personal@gmail.com\",\n  \"departmentId\": \"dept-001\",\n  \"teamId\": \"team-001\",\n  \"position\": \"DevOps Engineer\"\n}",
